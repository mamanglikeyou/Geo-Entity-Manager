# Base URL of the backend API. Leave empty to use the same origin
# (the Vite dev server proxies /api to the backend).
VITE_API_BASE_URL=

# MapLibre style URL. Defaults to OpenFreeMap (free, no API key).
VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# Where the dev server proxies /api requests to.
VITE_API_PROXY_TARGET=http://localhost:8080
